{
  "manifest_version": 3,
  "name": "Loop Fans Multi-Theme",
  "version": "0.2.0",
  "description": "Switch between multiple themes on gu.loop.fans.",
  "permissions": ["scripting", "storage", "declarativeContent", "tabs"],
  "host_permissions": ["https://gu.loop.fans/*"],
  "background": { "service_worker": "service_worker.js" },
  "action": { "default_title": "Loop Fans Themes", "default_popup": "popup.html" },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
